# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Managed PostgreSQL (Cloud SQL) Runtime Variables (Automatically injected)
SQL_HOST=""
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Optional External Supabase Credentials (If deploying outside managed Cloud SQL)
# Provide Project URL and Anon Public Key for client; keep Service Role Key strictly server-side
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key-backend-only"
